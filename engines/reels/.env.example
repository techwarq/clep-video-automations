# Copy to .env and fill in. Never commit .env.

# Model calls (planning, HTML writing, vision checks) via OpenRouter.
OPENROUTER_API_KEY=
# REELS_MODEL=meta/muse-spark-1.3-contributor     # any OpenRouter model id works
# REELS_BUDGET_USD=1.00                           # hard cap on model spend per run

# Optional paid voiceover (the CLI always asks before using it).
# ELEVENLABS_APIKEY=
# ELEVENLABS_USD_PER_1K_CHARS=0.30                # used for the cost estimate

# Optional tool paths (default: ffmpeg-full from Homebrew, else PATH).
# REELS_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# REELS_FFPROBE=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
