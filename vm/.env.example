# Copy to .env (local) or /opt/video-automation/.env (VM). Never commit.

# ---- Cloudflare queue (VM pulls jobs over HTTP) ----
CF_ACCOUNT_ID=
CF_QUEUE_ID=
CF_API_TOKEN=

# ---- the Worker API ----
API_URL=https://video-automation-api.<you>.workers.dev
INTERNAL_KEY=                 # same value as the Worker's INTERNAL_KEY secret

# ---- engines ----
OPENROUTER_API_KEY=
ELEVENLABS_APIKEY=            # optional, only for --tts reels
RENDER_WORKERS=2              # browser slots per render; 4 GB VM → 2
MOTION_BUDGET_USD=0.30        # hard cap on model spend per motion film

# Local runs only (Docker uses the image's Python for both engines)
# REELS_PYTHON=../engines/reels/venv/bin/python
# MOTION_PYTHON=../engines/motion/venv/bin/python
